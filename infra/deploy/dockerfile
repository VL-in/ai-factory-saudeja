# Imagem combinada de deploy: API FastAPI + interface Streamlit no mesmo
# container (Passo 11 do PLANO-IMPLEMENTACAO.md, antecipada no Passo 4 para
# permitir testar o conjunto localmente do jeito que ele vai rodar no Hugging
# Face Space). Ver infra/deploy/entrypoint.sh para o porque de dois processos.
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# api.txt + ui.txt (ambos puxam base.txt); train.txt fica de fora -- jupyter/
# matplotlib/imbalanced-learn so servem ao pipeline de treino e pesariam no
# cold start (SLO §2).
COPY requirements/ ./requirements/
RUN pip install --no-cache-dir -r requirements/api.txt -r requirements/ui.txt

COPY src/ ./src/
COPY params.yaml .
COPY infra/deploy/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# model.pkl EMPACOTADO na imagem, ao contrario de infra/api/dockerfile (que o
# monta por volume em dev): no HF Space nao ha DVC nem acesso ao remote em
# runtime, e o Passo 9 decidiu que a fonte de verdade do modelo campeao e o
# artefato versionado, nao um MLflow ao vivo. Build sem `dvc pull` falha aqui,
# de proposito -- melhor que subir um container sem modelo.
COPY data/model.pkl /app/data/model.pkl

# STREAMLIT_BROWSER_SERVER_ADDRESS (Passo 10.5): sem ele, o Streamlit em modo
# headless consulta um servico externo para descobrir o IP publico da maquina
# e o imprime no log ("External URL: http://<ip>:7860") -- uma requisicao de
# saida que o produto nao precisa, e um IP num log que o CI varre com
# scripts/auditoria_lgpd.py e que, no Actions, e' publico. O valor so' muda a
# URL impressa e o CORS de upload de arquivo, que a UI nao usa; conexoes da
# propria origem (o Space) continuam permitidas.
ENV MODEL_PATH=/app/data/model.pkl \
    APP_ENV=prod \
    PREDICT_BACKEND=processo \
    API_PORT=8000 \
    UI_PORT=7860 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_BROWSER_SERVER_ADDRESS=localhost

# 7860 e a porta que o HF Space publica por padrao (SDK Docker) -- a UI fica
# nela. 8000 e a API; ver a ressalva sobre porta unica no Space em
# PLANO-IMPLEMENTACAO.md, Passo 11.
EXPOSE 7860 8000

CMD ["./entrypoint.sh"]
