# Imagem combinada de deploy: API FastAPI + interface Streamlit no mesmo
# container, a mesma que roda no Hugging Face Space. Serve tambem para
# testar o conjunto localmente do jeito que ele vai rodar no Hugging
# Face Space). Ver infra/deploy/entrypoint.sh para o porque de dois processos.
#
# No Space, o contexto de build NAO e' o repositorio: e' o staging de lista
# fechada montado por scripts/montar_staging_space.py, e o CI builda a partir
# do mesmo staging. Toda origem de COPY abaixo tem de estar na lista de la --
# tests/test_deploy.py trava isso.
#
# Camadas da menos para a mais volatil: dependencias (mudam por
# Dependabot) -> modelo (muda no re-treino mensal) -> params/entrypoint -> src/
# (muda a cada PR). Um PR so' de codigo reaproveita a camada do pip inteira.
FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# api.txt + ui.txt (ambos puxam base.txt), um a um em vez do diretorio: mudar
# train.txt/dev.txt/dvc.txt nao invalida o cache desta camada. train.txt fica
# de fora -- jupyter/matplotlib/imbalanced-learn so' servem ao pipeline de
# treino e pesariam no build e no cold start (SLO §2).
COPY requirements/base.txt requirements/api.txt requirements/ui.txt ./requirements/
RUN pip install --no-cache-dir -r requirements/api.txt -r requirements/ui.txt

# Usuario nao-root com uid 1000: o Space roda o container
# como uid 1000 qualquer que seja o USER daqui, entao a imagem ja' nasce assim
# e o smoke do CI testa a mesma condicao. HOME gravavel e' o que o Streamlit
# (~/.streamlit) e o cache do numba, que o shap usa, precisam; /app continua
# do root e so' de leitura para o processo.
RUN useradd --create-home --uid 1000 user
ENV HOME=/home/user

# model.pkl EMPACOTADO na imagem, ao contrario de infra/api/dockerfile (que o
# monta por volume em dev): no HF Space nao ha DVC nem acesso ao remote em
# runtime, e a fonte de verdade do modelo campeao e o
# artefato versionado pelo DVC (escolhido pelo gate de re-treino), nao um
# MLflow ao vivo. Build sem `dvc pull` falha aqui,
# de proposito -- melhor que subir um container sem modelo.
COPY data/model.pkl /app/data/model.pkl
COPY params.yaml .
# Tema da UI: o Streamlit procura .streamlit/config.toml no diretorio de
# trabalho (/app), de onde o entrypoint o inicia.
COPY .streamlit/config.toml ./.streamlit/config.toml
COPY infra/deploy/entrypoint.sh ./entrypoint.sh
RUN chmod 755 ./entrypoint.sh

# Bytecode compilado no build: com /app so' de leitura para o uid 1000, o
# Python nao consegue gravar __pycache__ em runtime e recompilaria src/ a cada
# cold start (SLO §2).
COPY src/ ./src/
RUN python -m compileall -q src

# STREAMLIT_BROWSER_SERVER_ADDRESS: sem ele, o Streamlit em modo
# headless consulta um servico externo para descobrir o IP publico da maquina
# e o imprime no log ("External URL: http://<ip>:7860") -- uma requisicao de
# saida que o produto nao precisa, e um IP num log que o CI varre com
# scripts/auditoria_lgpd.py e que, no Actions, e' publico. O valor so' muda a
# URL impressa e o CORS de upload de arquivo, que a UI nao usa; conexoes da
# propria origem (o Space) continuam permitidas.
#
# PYTHONUNBUFFERED: o log do Space so' mostra o que chegou ao stdout; com
# buffer, a linha que explica uma queda morre junto com o processo.
ENV MODEL_PATH=/app/data/model.pkl \
    APP_ENV=prod \
    PREDICT_BACKEND=processo \
    API_PORT=8000 \
    UI_PORT=7860 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_BROWSER_SERVER_ADDRESS=localhost

USER user

# 7860 e a porta que o HF Space publica por padrao (SDK Docker) -- a UI fica
# nela. 8000 e a API, que so' fica acessivel localmente: o Space publica
# uma unica porta (app_port), entao em producao so' a UI e' publica.
EXPOSE 7860 8000

CMD ["./entrypoint.sh"]
