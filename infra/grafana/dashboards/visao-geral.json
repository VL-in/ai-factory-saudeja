{
  "uid": "saudeja-visao-geral",
  "title": "SaúdeJá — Visão geral (SLO)",
  "description": "Os compromissos do SLO num lugar só: fila D-2, explicação, disponibilidade e custo.",
  "tags": [
    "saudeja"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Último job D-2 com sucesso",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select ultimo_ok as \"último ok\" from observabilidade.ultimo_job_d2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "SLO §1: a fila de amanhã a D+2 processada até as 09h."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agendamentos deixados para trás hoje",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(agendamentos), 0) as agendamentos\nfrom observabilidade.agendamentos_sem_processamento_por_dia\nwhere dia = (now() at time zone 'America/Sao_Paulo')::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Criados antes do job de hoje, na janela dele, sem predição nem mensagem (P1)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cobertura da explicação no período",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select sum(com_explicacao)::numeric / nullif(sum(predicoes), 0) as cobertura\nfrom observabilidade.predicoes_por_dia where $__timeFilter(dia)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "SLO §4: 100%."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disponibilidade da interface (sonda, até 14 dias)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "refId": "A",
          "expr": "sum(increase(probe_all_success_sum{job=\"${CHECK_SM}\"}[$__range]))\n/ sum(increase(probe_all_success_count{job=\"${CHECK_SM}\"}[$__range]))",
          "editorMode": "code",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "SLO §1.1: ≥ 99%. Synthetic Monitoring; o Grafana guarda 14 dias."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agendamentos processados, disparos e taxa de disparo",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select dia::timestamptz as time, agendamentos_processados as processados,\n       disparos, taxa_de_disparo\nfrom observabilidade.disparos_por_dia\nwhere $__timeFilter(dia)\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "taxa_de_disparo"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Custo de SMS projetado para o mês (US$)",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select round(coalesce(sum(segmentos_projetados), 0) * ${CUSTO_SMS_UNITARIO_USD}, 2)\n       as custo_projetado_usd\nfrom observabilidade.envios_cobrados_por_mes\nwhere canal = 'sms' and mes = date_trunc('month', now() at time zone 'America/Sao_Paulo')::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": "${CUSTO_ORCAMENTO_USD}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": "${CUSTO_LIMITE_USD}"
              },
              {
                "color": "red",
                "value": "${CUSTO_ORCAMENTO_USD}"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Ações e eventos no mês: volume, taxa de erro e percentis",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select tipo, acao, origem, eventos, erros, recusados, taxa_de_erro,\n       round(p50_ms) as p50_ms, round(p95_ms) as p95_ms, round(p99_ms) as p99_ms\nfrom observabilidade.eventos_por_mes\nwhere mes = date_trunc('month', now() at time zone 'America/Sao_Paulo')::date\norder by eventos desc"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "taxa_de_erro"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "Percentis exatos do Postgres (90 dias de eventos_app). Recusa esperada conta no total e nunca no numerador da taxa de erro."
    }
  ]
}
