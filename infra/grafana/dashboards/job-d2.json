{
  "uid": "saudeja-job-d2",
  "title": "SaúdeJá — Job D-2",
  "description": "A execução diária: quando rodou, quanto levou, o que processou e o que ficou para trás.",
  "tags": [
    "saudeja"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Último job D-2 com sucesso",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select ultimo_ok as \"último ok\" from observabilidade.ultimo_job_d2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Última execução (qualquer status)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select ultima_execucao as \"última\" from observabilidade.ultimo_job_d2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Deixados para trás hoje",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(sum(agendamentos), 0) as agendamentos\nfrom observabilidade.agendamentos_sem_processamento_por_dia\nwhere dia = (now() at time zone 'America/Sao_Paulo')::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duração da fila por dia",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select dia::timestamptz as time, max(p99_ms) as duracao_ms\nfrom observabilidade.eventos_por_dia\nwhere tipo = 'job_d2' and $__timeFilter(dia)\ngroup by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "De `processar_dia` (busca da fila até o último lembrete). Alerta P3 acima de ${JOB_D2_DURACAO_MAXIMA_MIN} min."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agendamentos deixados para trás por dia",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select dia::timestamptz as time, agendamentos\nfrom observabilidade.agendamentos_sem_processamento_por_dia\nwhere $__timeFilter(dia) order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agendamentos por resultado (por execução)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MIMIR}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MIMIR}"
          },
          "refId": "A",
          "expr": "sum by (resultado) (last_over_time(saudeja_job_d2_agendamentos_total{job=\"saudeja-job-d2\", deployment_environment=\"${AMBIENTE}\"}[1d]))",
          "editorMode": "code",
          "legendFormat": "{{resultado}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "O job vive alguns minutos por dia, e o contador recomeça a cada execução: cada ponto é o total da última execução no dia.",
      "interval": "1d"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Execuções e falhas do job por dia",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_SUPABASE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SUPABASE}"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select dia::timestamptz as time, sum(eventos) as execucoes, sum(erros) as falhas\nfrom observabilidade.eventos_por_dia\nwhere tipo = 'job_d2' and $__timeFilter(dia)\ngroup by 1 order by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "SLO §1: uma execução por dia (o cron do GitHub, reserva do gatilho do pg_cron, pode somar uma segunda sem efeito)."
    },
    {
      "id": 8,
      "type": "text",
      "title": "Traces de uma execução",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "No **Explore → Tempo**, o trace inteiro de uma execução: `{ resource.service.name = \"saudeja-job-d2\" && name = \"execucao_job_d2\" }`. Para um run do Actions específico: `{ span.id_execucao = \"gh-<run>-<tentativa>\" }` (o mesmo `id_execucao` de `eventos_app.detalhe` e da linha de resumo do log)."
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Log do job (já sem dado pessoal)",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "refId": "A",
          "expr": "{service_name=\"saudeja-job-d2\"} | deployment_environment=\"${AMBIENTE}\"",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
