# Caminho dos dados (Camila usava local)
DATA_PATH=./data/consultas-historicas.csv

# Caminho do modelo
MODEL_PATH=./data/model.pkl

# MLflow (tracking server externo, persistente entre runs -- ver docker-compose.yml)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=saudeja-no-show

# Supabase (src/db/). Local, aponte SEMPRE para o projeto de DEV (docs/architecture.md §6,
# "Ambientes e releases"):
# producao e' outro projeto, cujas credenciais so' existem no environment
# `production` do GitHub e nos secrets do Space de producao.
# SUPABASE_SECRET_KEY é a chave secreta
# (sb_secret_..., formato novo que substitui o JWT service_role) -- nunca a
# publishable (sb_publishable_..., equivalente à antiga anon). O backend
# (UI em processo, job D-2) precisa da secreta para ignorar RLS (ver
# supabase/migrations/20260919000000_init.sql). Nunca versionar valores reais.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Fuso em que a clinica raciocina sobre datas ("fila do dia 19/09" = 19/09 em
# Sao Paulo). O container roda em UTC: sem isso, depois das 21h a fila do dia
# e o job D-2 trabalhariam com a data errada.
TIMEZONE_CLINICA=America/Sao_Paulo

# Interface Streamlit (src/ui/app.py)
# APP_ENV=dev expõe a aba "Dev: disparo manual"; em producao (HF Space) use prod
APP_ENV=dev
# Como a UI obtem a predicao: processo (default, ADR-005 b -- import direto de
# src/inference.py) ou api (fala com a API FastAPI por HTTP, harness visual da API)
PREDICT_BACKEND=processo
# So usado quando PREDICT_BACKEND=api
API_BASE_URL=http://127.0.0.1:8000

# Job de inferencia diaria D-2 (src/jobs/inferencia_diaria.py)
# Provedor de mensageria: stub (default, nunca faz rede) ou infobip
# (envia SMS de verdade via src/messaging/client.py::InfobipClient). Outro
# valor levanta erro explicito (nao ha fallback silencioso para nao mascarar
# configuracao de producao errada).
MESSAGING_PROVIDER=stub

# Infobip (src/messaging/client.py). So usado com
# MESSAGING_PROVIDER=infobip. INFOBIP_BASE_URL e' so o host (sem "https://"),
# como aparece no painel do Infobip (ex. "xxxxxx.api.infobip.com").
# INFOBIP_CHAVE_API e' a API Key (Authorization: App <chave>, ver
# https://www.infobip.com/docs/essentials/api-essentials/api-authentication).
# INFOBIP_REMETENTE e' o "from" do SMS (opcional, default "SaudeJa" -- no
# sandbox de teste a Infobip pode ignorar/sobrescrever com um remetente
# proprio). Nunca versionar valores reais.
INFOBIP_BASE_URL=xxxxxx.api.infobip.com
INFOBIP_CHAVE_API=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INFOBIP_REMETENTE=SaudeJa

# So para o teste manual unico contra o sandbox real da Infobip (fora do CI,
# antes do primeiro envio em producao) -- numero de telefone (com codigo do
# pais) para onde mandar o SMS de verificacao. Nunca hardcoded em script/doc:
# fica so aqui, no .env local, que e' gitignored.
INFOBIP_TELEFONE_TESTE=5511999999999

# Observabilidade de aplicacao (src/observabilidade.py, ADR-006).
# OBSERVABILIDADE_ATIVA=false desliga o registro em `eventos_app` por completo
# (escape hatch para rodar um script local sem sujar a tabela); o normal e'
# deixar ligado. OBSERVABILIDADE_RETENCAO_DIAS e' a janela de retencao aplicada
# pela purga que roda junto do job diario -- a tabela cresce a cada predicao e
# divide o teto do free tier do Supabase com os dados do produto.
OBSERVABILIDADE_ATIVA=true
OBSERVABILIDADE_RETENCAO_DIAS=90

# Telemetria OpenTelemetry -> Grafana Cloud (src/telemetria.py, Passo 8.9).
# Vazio = telemetria desligada (no-op); e' o normal local e no CI.
# OBSERVABILIDADE_ATIVA=false tambem a desliga. Endpoint e cabecalho saem da
# pagina OpenTelemetry do stack no portal do Grafana Cloud; o cabecalho leva
# `Authorization=Basic%20<base64 de instanceID:token>` (%20, nao espaco).
# Secrets dos environments do Actions e dos dois Spaces; nunca em arquivo
# versionado. APP_VERSION vira service.version (no Actions, sem ela, usa o sha).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
APP_VERSION=

# Alertas, politicas de notificacao e paineis do Grafana como codigo
# (scripts/grafana_provisionar.py, .github/workflows/grafana.yml, infra/grafana/).
# GRAFANA_URL e GRAFANA_SA_TOKEN: secrets dos environments `dev` e `production`
# do Actions. Token de service account com papel Admin (o endpoint de
# provisionamento de alertas recusa Editor com 403).
# GRAFANA_DS_SUPABASE: VARIAVEL de cada environment, com o UID (nao o nome) da
# fonte Postgres do Supabase daquele ambiente -- Connections -> Data sources ->
# a fonte; o UID e' o fim da URL da pagina. Mimir e Loki usam as fontes padrao
# do Grafana Cloud (grafanacloud-prom, grafanacloud-logs); GRAFANA_DS_MIMIR e
# GRAFANA_DS_LOKI so' se o stack tiver outras. Os contact points (saudeja-p1,
# saudeja-p2, saudeja-p2-modelo, saudeja-p3, saudeja-dev) sao criados a mao no
# Grafana: e-mail e Telegram nao entram no git.
GRAFANA_URL=
GRAFANA_SA_TOKEN=
GRAFANA_DS_SUPABASE=
#
# O gatilho do job D-2 (pg_cron do Supabase de producao, migration
# 20261017010000_gatilho_job_d2.sql) le o token do GitHub do Vault do proprio
# Supabase, nunca de variavel de ambiente nem do git. Token fine-grained, so'
# deste repositorio, com "Actions: Read and write"; criado no SQL Editor de
# PRODUCAO, nunca no de dev (o disparo e' sempre do job de producao):
#     select vault.create_secret('<token>', 'github_job_d2_token');
#     select vault.create_secret('<dono>/<repositorio>', 'github_job_d2_repositorio');

# Log estruturado com redacao de PII (src/logging_config.py, LGPD).
# LOG_LEVEL: nivel do logger raiz (default INFO). LOG_FORMATO: json (default,
# uma linha JSON por registro) ou texto (leitura local). A redacao de PII vale
# nos dois, porque mora no FILTRO do handler e nao no formatador -- ver
# docs/LGPD.md secao 8.
LOG_LEVEL=INFO
LOG_FORMATO=json

# Retencao dos dados DERIVADOS (predicoes, mensagens_disparadas), aplicada pela
# purga que roda junto do job diario -- principio da necessidade da LGPD
# (Art. 6, III), politica em docs/LGPD.md secao 5. Nao toca pacientes/
# agendamentos: o registro do atendimento e' da clinica (controladora), nao da
# SaudeJa (operadora). 90 dias: janela de rastreabilidade e auditoria do
# modelo (canario de ate' 21 dias + desfecho, SLO de explicacao em 30 dias).
RETENCAO_DADOS_DERIVADOS_DIAS=90

# Base de treino (schema `treino`, ADR-010): so' as consultas de quem consentiu,
# sem nome, telefone, CPF nem data de nascimento, com o titular e a consulta
# identificados por pseudonimo HMAC (src/pseudonimo.py).
# TREINO_CHAVE_PSEUDONIMO: chave do HMAC, com pelo menos 32 caracteres (gere
# com `python -c "import secrets; print(secrets.token_hex(32))"`). Uma por
# ambiente, so' em .env/secrets. NAO RODA: trocar a chave quebra o vinculo com
# as linhas e as provas ja' gravadas; vazamento e' incidente (LGPD.md secao 10).
# Vai para o Space (tela de agendamento) e para o job D-2 (sincronizacao do
# desfecho); nunca para o re-treino nem para o canario. Sem ela, o agendamento
# segue normalmente e so' a etapa de treino deixa de rodar.
# JANELA_TREINO_DIAS: janela da base de treino (export, sincronizacao e purga).
# Nao vai para secret nem para os workflows: sem ela, os tres usam o default
# do codigo (90). Se um dia mudar, mude no retrain.yml, no job_d2.yml e no
# lgpd.yml juntos -- sincronizar com janela maior que a da purga devolveria a
# base de treino o que a purga tirou.
TREINO_CHAVE_PSEUDONIMO=
JANELA_TREINO_DIAS=90

# Export do dataset de treino a partir dos desfechos reais registrados
# pela clinica na "Fila do dia" (src/export_treino.py) -- semente herdada da Camila (intocada) + producao
# real. So' precisam mudar em teste/CI; em uso normal os defaults (raiz do
# repositorio) bastam.
CONSULTAS_HISTORICAS_PATH=./data/consultas-historicas.csv
CONSULTAS_TREINO_PATH=./data/consultas-treino.csv

# Remote do DVC em Azure Blob Storage (de onde o re-treino, o CI, o deploy e
# o job D-2 baixam o model.pkl). Nem a URL nem a credencial
# ficam em .dvc/config, que E' versionado: la' so' fica `[core] remote = azure`.
# A URL carrega o nome do container onde o dataset de treino (com desfechos
# reais registrados pela clinica, pseudonimizados) esta' versionado -- nome de
# conta/container em repositorio publico e' reconhecimento de graca.
#
# Local: rode UMA vez (escreve .dvc/config.local, que o git ignora):
#     dvc remote add --local -f azure "azure://<container>/<prefixo>"
# CI: DVC_REMOTE_URL e' secret do repositorio; as credenciais sao SAS do
# container (AZURE_STORAGE_CONNECTION_STRING_LEITURA e _ESCRITA, abaixo). Os
# workflows escrevem o config.local no runner.
#
# Regiao da conta de armazenamento: Brazil South, desde 2026-10-09 (antes, Chile
# Central -- ver a emenda de 2026-10-09 no ADR-005 e docs/LGPD/LGPD.md 4.3).
# A regiao e' da CONTA, nao do container, e nao muda depois de criada: trocar de
# regiao exige conta nova. Redundancia LRS de proposito: GRS copiaria os blobs
# para a regiao pareada, nos Estados Unidos. Nunca versionar valores reais.
DVC_REMOTE_URL=azure://xxxxxxxx/dvc-store
# Credencial local: a MESMA SAS de leitura do CI (key1, --permissions rl).
# `dvc pull`, `dvc status --cloud` e scripts/purgar_dvc_local.py so' leem; o
# push e' do retrain.yml. Nunca a account key: ela le, grava e apaga na conta
# inteira e gera SAS novas -- o poder que o ADR-009 isola no environment `lgpd`.
# Formato de connection string (BlobEndpoint + SharedAccessSignature), nao a
# "URL do SAS" do portal: o token vai sem o `?` e o endpoint sem o container.
# O `dvc` le esta variavel do AMBIENTE, nao do .env: carregue-a na sessao antes
# de usar o dvc direto (README, secao "Baixar dataset e modelo").
AZURE_STORAGE_CONNECTION_STRING=BlobEndpoint=https://xxxxxxxx.blob.core.windows.net/;SharedAccessSignature=sp=rl&st=...&se=...&spr=https&sv=...&sr=c&sig=...

# Dead-man's-switch do re-treino mensal (ADR-006). Workflow
# agendado do GitHub e' desativado depois de inatividade prolongada do
# repositorio: sem esse ping, o re-treino pode parar de rodar em silencio e o
# SLO 5 (100% dos meses) fica violado sem ninguem perceber. Vira secret
# HEALTHCHECKS_RETRAIN_URL no Actions; o check em si so' existe a partir do
# deploy no HF Space, que tem URL publica -- ate' la' a variavel fica vazia e o workflow
# pula o ping em vez de falhar.
HEALTHCHECKS_RETRAIN_URL=

# Dead-man's-switch do job D-2 (ADR-006). Mesmo mecanismo do
# re-treino: .github/workflows/job_d2.yml pinga este check ao terminar bem e
# pinga <url>/fail quando a pre ou a pos-checagem falham. Vazio = sem ping
# (o workflow pula o passo em vez de falhar). Secret HEALTHCHECKS_JOB_D2_URL.
HEALTHCHECKS_JOB_D2_URL=

# --- So' no GitHub Actions (.github/workflows/): nao precisam existir no .env local ---
#
# Onde cada um mora (docs/architecture.md §6, "Ambientes e releases"). Environment secret tem precedencia sobre o de
# repositorio com o mesmo nome; aqui nenhum nome se repete entre os niveis.
#   Repositorio (o CI roda sem environment):
#     secrets DVC_REMOTE_URL, AZURE_STORAGE_CONNECTION_STRING_LEITURA
#   Environment `dev` (branch dev; deploy no Space e no Supabase de dev):
#     secrets HF_TOKEN, SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD,
#             SUPABASE_PROJECT_REF
#     variavel HF_SPACE_ID
#   Environment `production` (branch main; deploy + job D-2, canario, re-treino
#   e alerta de observabilidade):
#     secrets os quatro do dev (com os valores de producao), SUPABASE_URL,
#             SUPABASE_SECRET_KEY, AZURE_STORAGE_CONNECTION_STRING_ESCRITA
#             (so' o re-treino usa), TREINO_CHAVE_PSEUDONIMO (so' o job D-2
#             usa), INFOBIP_BASE_URL, INFOBIP_CHAVE_API,
#             HEALTHCHECKS_JOB_D2_URL, HEALTHCHECKS_RETRAIN_URL,
#             HEALTHCHECKS_CANARIO_URL, HEALTHCHECKS_ALERTA_URL (um check do
#             Healthchecks por workflow agendado; vazio = sem ping)
#     variaveis HF_SPACE_ID, MESSAGING_PROVIDER, INFOBIP_REMETENTE,
#               CANARIO_DESLIGADO, REVISOR_PRS_MODELO (usuario do GitHub que
#               recebe o pedido de revisao dos PRs do re-treino e do canario;
#               vazia = dono do repositorio)
#   Environment `lgpd` (so' main; workflow de purga, ADR-009):
#     secrets SUPABASE_URL, SUPABASE_SECRET_KEY (os de producao),
#             AZURE_STORAGE_CONNECTION_STRING_EXCLUSAO, HEALTHCHECKS_LGPD_URL
#
# Credenciais do remote do DVC no Actions: tres SAS do container, nunca a
# account key (que le, grava e apaga na conta inteira, e com a qual da' para
# gerar SAS novas). Nos workflows, cada uma e' exposta aos passos com o nome
# AZURE_STORAGE_CONNECTION_STRING, que e' o que o DVC le. Formato:
#     BlobEndpoint=https://<conta>.blob.core.windows.net/;SharedAccessSignature=<sas>
# com a <sas> gerada por
#     az storage container generate-sas --account-name <conta> --name <container> \
#       --account-key <chave> --permissions <perm> --expiry <data> --https-only -o tsv
# (as chaves saem de `az storage account keys list --account-name <conta>`).
#
# A conta tem so' duas chaves. SAS avulsa so' deixa de valer quando expira ou
# quando a chave que a assinou e' rotacionada: por isso a leitura e a escrita
# sao assinadas com chaves diferentes, e um vazamento da de escrita se resolve
# rotacionando a key2, sem derrubar CI, deploy e job D-2. A de exclusao nao tem
# terceira chave: e' presa a uma stored access policy (abaixo), que a revoga
# sozinha. Gere a leitura e a escrita com a mesma --expiry e anote a data: SAS
# vencida derruba os workflows que a usam.
#
# LEITURA -- CI, deploy, job D-2 e canario, que so' fazem `dvc pull`. O CI roda
# codigo de PR. key1, --permissions rl (read, list). Secret de repositorio.
AZURE_STORAGE_CONNECTION_STRING_LEITURA=BlobEndpoint=https://xxxxxxxx.blob.core.windows.net/;SharedAccessSignature=sv=xxxx-xx-xx&sp=rl&...
# ESCRITA -- so' o retrain.yml, que faz `dvc pull` e `dvc push`. key2,
# --permissions rlcw (read, list, create, write). So' create (rlc) nao basta:
# o adlfs sobe com upload_blob(overwrite=True), sem If-None-Match, e o Azure
# exige w (o push com rlc da' AuthorizationPermissionMismatch). Sem d: nao
# apaga, e o remote do DVC e' enderecado por conteudo (objeto novo = hash
# novo; o push pula o que ja' existe), entao sobrescrever regrava os mesmos
# bytes. A exclusao fica so' com o workflow de purga (EXCLUSAO, abaixo).
# Secret do environment `production`.
AZURE_STORAGE_CONNECTION_STRING_ESCRITA=BlobEndpoint=https://xxxxxxxx.blob.core.windows.net/;SharedAccessSignature=sv=xxxx-xx-xx&sp=rcwl&...
# EXCLUSAO -- so' o lgpd.yml, que lista e apaga blobs expirados ou de titular
# (ADR-009). rld (read, list, delete), sem w: nao substitui arquivo nenhum.
# Presa a' stored access policy `purga-lgpd` do container e assinada com a
# key2 (a key1 esta' em mais lugares, CI e .env local, e tem mais chance de
# ser rotacionada). Permissoes e validade ficam na policy, nao na SAS:
#     az storage container policy create --account-name <conta> \
#       --container-name <container> --name purga-lgpd --permissions rld \
#       --expiry <data> --account-key <key2>
#     az storage container generate-sas --account-name <conta> --name <container> \
#       --policy-name purga-lgpd --https-only --account-key <key2> -o tsv
# (no portal: container -> Politica de acesso, e Tokens de acesso compartilhado
# com a policy selecionada). O token sai com si=purga-lgpd e SEM sp= e se=; se
# vierem, a SAS ficou avulsa. Estender a validade: `policy update --expiry`,
# sem trocar o secret. Revogar so' a purga: apagar a policy. Rotacionar a key2
# derruba esta SAS junto com a de escrita. Secret do environment `lgpd`.
AZURE_STORAGE_CONNECTION_STRING_EXCLUSAO=BlobEndpoint=https://xxxxxxxx.blob.core.windows.net/;SharedAccessSignature=si=purga-lgpd&spr=https&sv=xxxx-xx-xx&sr=c&sig=...
#
# Deploy no Hugging Face Space (deploy.yml, um Space por environment). Token
# fine-grained com escrita SO' no Space daquele environment (o token passa por uma action de
# terceiro, entao o estrago possivel fica limitado a esse Space). O id do Space
# (<usuario>/<space>) vai como VARIAVEL do environment, HF_SPACE_ID, para o
# mesmo workflow servir aos dois Spaces. Nao e' segredo: o endereco publico
# de cada Space (README, "URL publica") e' derivado dele.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_SPACE_ID=xxxxxxxx/xxxxxxxx
#
# Migrations do Supabase aplicadas pelo deploy (deploy.yml, um projeto por
# environment). Existem porque o deploy e' automatico e a migration era manual:
# um PR com migration mergeado sem `supabase db push` deixa o codigo de producao
# rodando contra schema antigo (aconteceu em 2026-09-28, erro 42703 na "Fila do
# dia"). SUPABASE_ACCESS_TOKEN e' o token PESSOAL do CLI, nao a chave do
# projeto. Token com escopo (o recomendado), restrito ao projeto do
# environment, com Read em: Project Settings, API Keys e API Key Secrets (o
# `supabase link`) e Connection Pooling (o runner nao tem IPv6 e o deploy le a
# URL do pooler IPv4 pela API -- sem ela, 403).
# SUPABASE_PROJECT_REF fica fora do git pelo mesmo motivo da URL do
# remote do DVC: identificador de infraestrutura em repositorio e'
# reconhecimento de graca. Local nenhuma das tres e' necessaria -- o
# `supabase login` guarda o token, o `supabase link` guarda o ref em
# supabase/.temp/ (gitignored) e o `supabase db push` pede a senha no terminal --
# e deixar o token (acesso a todos os seus projetos) e a senha do banco no .env
# seria risco sem uso. Nunca versionar valores reais.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=xxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
#
# No job D-2 do Actions, MESSAGING_PROVIDER e INFOBIP_REMETENTE sao VARIAVEIS
# do environment `production` (vars), e o workflow FALHA se MESSAGING_PROVIDER nao estiver
# definido: com `stub`, o job marca agendamentos.lembrete_enviado sem SMS
# nenhum ter saido -- e o re-treino le isso como "foi lembrado". INFOBIP_BASE_URL
# e INFOBIP_CHAVE_API sao secrets.
#
# Canario do modelo (ADR-008, src/canario.py). CANARIO_DESLIGADO e'
# VARIAVEL do environment `production` (vars), opcional: `true` faz o job D-2 ignorar o
# canario a partir da proxima execucao -- rollback manual instantaneo, sem PR
# nem deploy. Vazia ou ausente, o canario ativo em main e' usado. Local, vale
# o mesmo para `python src/jobs/inferencia_diaria.py`.
CANARIO_DESLIGADO=
